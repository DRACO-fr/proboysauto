rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email.lower() in ['moagil75@gmail.com', 'kabomoagi14@gmail.com'];
    }
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
